# Google OAuth Configuration
# TODO: Replace with your actual Google OAuth credentials from https://console.cloud.google.com
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Super Admin Configuration
# TODO: Replace with your actual Google email address
SUPER_ADMIN_EMAIL=your-email@gmail.com

# JWT Secret Key
# TODO: Generate a secure random string for production
JWT_SECRET_KEY=dev-secret-key-change-in-production

# Server Configuration
HOST=localhost
PORT=8000